// ─── PRODUCT DETAIL ───────────────────────────────────────────────────────────
function ProductPage({ productId, navigate, addToCart }) {
  const product = PRODUCTS.find(p => p.id === productId);
  const [selectedSize, setSelectedSize] = useState(null);
  const [imgView, setImgView] = useState('front');
  const [added, setAdded] = useState(false);

  if (!product) return <div style={{ padding: '120px 40px', textAlign: 'center' }}><p style={{ fontFamily: 'var(--font-serif)', fontStyle: 'italic', fontSize: '32px', color: 'var(--mid-gray)' }}>Product not found</p><button className="btn-ghost" onClick={() => navigate('store')} style={{ marginTop: '24px' }}>Back to Store</button></div>;

  const related = PRODUCTS.filter(p => p.id !== product.id && p.category === product.category).slice(0, 3);

  const handleAddToCart = () => {
    if (!selectedSize) { alert('Please select a size'); return; }
    addToCart(product);
    setAdded(true);
    setTimeout(() => setAdded(false), 2000);
  };

  return (
    <div style={{ paddingTop: '80px', minHeight: '100vh' }}>
      {/* Breadcrumb */}
      <div style={{ padding: '20px 40px', display: 'flex', gap: '12px', alignItems: 'center' }}>
        <button onClick={() => navigate('store')} style={{ background: 'none', border: 'none', cursor: 'pointer', fontFamily: 'var(--font-mono)', fontSize: '10px', letterSpacing: '0.15em', color: 'var(--mid-gray)', textTransform: 'uppercase' }}>Store</button>
        <span style={{ color: 'var(--warm-gray)' }}>—</span>
        <p style={{ fontFamily: 'var(--font-mono)', fontSize: '10px', letterSpacing: '0.15em', color: 'var(--off-white)', textTransform: 'uppercase' }}>{product.name}</p>
      </div>

      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '2px', padding: '0 40px' }}>
        {/* Images */}
        <div>
          <div style={{ position: 'relative', overflow: 'hidden', paddingBottom: '110%', background: 'var(--near-black)', marginBottom: '2px' }}>
            {product.img ? (
              <img src={imgView === 'back' && product.imgBack ? product.imgBack : product.img}
                alt={product.name} style={{
                  position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover',
                  transition: 'opacity 0.4s ease',
                }} />
            ) : (
              <div style={{ position: 'absolute', inset: 0, background: 'var(--dark)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <p style={{ fontFamily: 'var(--font-display)', fontSize: '120px', color: 'var(--warm-gray)', opacity: 0.3 }}>BC</p>
              </div>
            )}
          </div>
          {product.imgBack && (
            <div style={{ display: 'flex', gap: '2px' }}>
              {['front', 'back'].map(view => (
                <button key={view} onClick={() => setImgView(view)} style={{
                  flex: 1, padding: '12px', background: imgView === view ? 'var(--warm-gray)' : 'var(--near-black)',
                  border: 'none', cursor: 'pointer', fontFamily: 'var(--font-mono)', fontSize: '9px',
                  letterSpacing: '0.2em', color: 'var(--off-white)', textTransform: 'uppercase',
                  transition: 'background 0.2s',
                }}>
                  {view}
                </button>
              ))}
            </div>
          )}
        </div>

        {/* Info */}
        <div style={{ padding: '20px 40px' }}>
          <div style={{ display: 'flex', gap: '8px', marginBottom: '24px', flexWrap: 'wrap' }}>
            {product.tags.map(tag => (
              <span key={tag} className="tag">{tag}</span>
            ))}
          </div>

          <p style={{ fontFamily: 'var(--font-mono)', fontSize: '10px', letterSpacing: '0.2em', color: 'var(--mid-gray)', textTransform: 'uppercase', marginBottom: '8px' }}>{product.subtitle}</p>
          <h1 style={{ fontFamily: 'var(--font-serif)', fontStyle: 'italic', fontSize: 'clamp(36px, 4vw, 54px)', lineHeight: 1.1, marginBottom: '16px' }}>{product.name}</h1>
          <p style={{ fontFamily: 'var(--font-mono)', fontSize: '18px', color: 'var(--cream)', letterSpacing: '0.05em', marginBottom: '32px' }}>{formatPrice(product.price)}</p>

          <div className="divider" style={{ marginBottom: '32px' }} />

          <p style={{ fontFamily: 'var(--font-serif)', fontSize: '16px', lineHeight: 1.8, color: 'var(--cream)', fontWeight: 300, marginBottom: '40px' }}>{product.description}</p>

          <div className="divider" style={{ marginBottom: '24px' }} />

          {/* Size selector */}
          <p style={{ fontFamily: 'var(--font-mono)', fontSize: '10px', letterSpacing: '0.2em', color: 'var(--mid-gray)', textTransform: 'uppercase', marginBottom: '12px' }}>Select Size</p>
          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap', marginBottom: '32px' }}>
            {product.sizes.map(size => (
              <button key={size} className={`size-btn ${selectedSize === size ? 'active' : ''}`}
                onClick={() => setSelectedSize(size)}>
                {size}
              </button>
            ))}
          </div>

          <button className="btn-primary" onClick={handleAddToCart} style={{ width: '100%', fontSize: '12px', padding: '18px' }}>
            <span>{added ? '✓ Added to Bag' : 'Add to Bag'}</span>
          </button>

          <div style={{ marginTop: '40px', display: 'flex', flexDirection: 'column', gap: '12px' }}>
            {[
              ['Handmade in South Africa', '◆'],
              ['Limited production run', '◆'],
              ['Each piece is unique', '◆'],
            ].map(([text, icon]) => (
              <div key={text} style={{ display: 'flex', gap: '12px', alignItems: 'center' }}>
                <span style={{ color: 'var(--accent)', fontSize: '8px' }}>{icon}</span>
                <p style={{ fontFamily: 'var(--font-mono)', fontSize: '10px', letterSpacing: '0.1em', color: 'var(--mid-gray)' }}>{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Related */}
      {related.length > 0 && (
        <section style={{ padding: '80px 40px 60px' }}>
          <h2 style={{ fontFamily: 'var(--font-display)', fontSize: '42px', letterSpacing: '0.03em', marginBottom: '40px' }}>YOU MAY ALSO LIKE</h2>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '2px' }}>
            {related.map(p => (
              <div key={p.id} className="product-card" onClick={() => navigate(`product-${p.id}`)} style={{ background: 'var(--near-black)' }}>
                <div style={{ position: 'relative', overflow: 'hidden', paddingBottom: '100%', background: 'var(--dark)' }}>
                  {p.img ? (
                    <img src={p.img} alt={p.name} className="product-img" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover' }} />
                  ) : (
                    <div className="product-img" style={{ position: 'absolute', inset: 0, display: 'flex', alignItems: 'center', justifyContent: 'center', background: '#141210' }}>
                      <p style={{ fontFamily: 'var(--font-display)', fontSize: '60px', color: 'var(--dark)' }}>BC</p>
                    </div>
                  )}
                </div>
                <div style={{ padding: '16px' }}>
                  <h3 style={{ fontFamily: 'var(--font-serif)', fontStyle: 'italic', fontSize: '18px' }}>{p.name}</h3>
                  <p style={{ fontFamily: 'var(--font-mono)', fontSize: '11px', color: 'var(--cream)', marginTop: '4px' }}>{formatPrice(p.price)}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <Footer navigate={navigate} />
    </div>
  );
}

