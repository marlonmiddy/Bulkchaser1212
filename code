    if (page === 'store-women') return <StorePage navigate={navigate} filter="women" />;
    if (page === 'store-men') return <StorePage navigate={navigate} filter="men" />;
    if (page === 'store-sneakers') return <StorePage navigate={navigate} filter="sneakers" />;
    if (page === 'store-beanies-caps' || page === 'store-beanies-&-caps') return <StorePage navigate={navigate} filter="beanies" />;
    if (page === 'art' || page === 'art-all') return <ArtPage navigate={navigate} type={null} />;
    if (page === 'art-murals') return <ArtPage navigate={navigate} type="murals" />;
    if (page === 'art-framed-pieces') return <ArtPage navigate={navigate} type="framed-pieces" />;
    if (page === 'create') return <CreatePage navigate={navigate} />;
    if (page === 'about') return <AboutPage navigate={navigate} />;
    if (page === 'contact') return <ContactPage navigate={navigate} />;
    if (page.startsWith('product-')) {
      const pid = page.replace('product-', '');
      return <ProductPage productId={pid} navigate={navigate} addToCart={addToCart} />;
    }
    return <HomePage navigate={navigate} />;
  };

  return (
    <>
      <style>{GLOBAL_CSS}</style>
      <div className="grain-overlay" />
      <div ref={pageRef} style={{ minHeight: '100vh', background: 'var(--black)', color: 'var(--off-white)' }}>
        <Nav navigate={navigate} cartCount={cart.length} currentPage={page} />
        <main style={{ animation: 'fadeIn 0.4s ease' }} key={page}>
          {renderPage()}
        </main>
      </div>
    </>
  );
}